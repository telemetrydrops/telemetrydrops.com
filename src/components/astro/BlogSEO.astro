---
import { ogCardForPath } from '../../lib/og-cards';
import { authors } from "../../data/author-data";

interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  authorKey: string;
  tags: string[];
  ogImage?: string;
  faqEntries?: FaqEntry[];
}

const { title, description, slug, publishedAt, updatedAt, authorKey, tags, faqEntries, ogImage } = Astro.props;

const author = authors[authorKey];
const canonicalUrl = `https://telemetrydrops.com/blog/${slug}/`;

const techArticle = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  '@id': `${canonicalUrl}#article`,
  image: new URL(ogImage ?? ogCardForPath(new URL(canonicalUrl).pathname).image, 'https://telemetrydrops.com').href,
  headline: title,
  description: description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author.name,
    jobTitle: author.role,
    "@id": `https://telemetrydrops.com${author.profilePath}#person`,
    url: `https://telemetrydrops.com${author.profilePath}`,
    sameAs: [author.social.linkedin, author.social.github, author.social.bluesky].filter(Boolean),
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://telemetrydrops.com/#organization",
    name: "Telemetry Drops",
    url: "https://telemetrydrops.com",
    logo: "https://telemetrydrops.com/logo.svg",
  },
  keywords: tags,
  url: canonicalUrl,
  mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
};

const faqPage = faqEntries && faqEntries.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqEntries.map((entry) => ({
        "@type": "Question",
        name: entry.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: entry.answer,
        },
      })),
    }
  : null;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(techArticle).replace(/</g, "\\u003c")} />
{faqPage && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage).replace(/</g, "\\u003c")} />}
