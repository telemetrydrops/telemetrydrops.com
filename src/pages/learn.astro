---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';

const paths = [
  {
    title: 'Build reliable Collector pipelines',
    audience: 'For SREs and platform engineers configuring telemetry collection and routing.',
    outcome: 'Learn to distinguish telemetry quality problems from volume problems, then work through a severity-based routing configuration.',
    resources: [
      { title: 'Start with telemetry quality and cost', href: '/blog/bad-telemetry-not-volume-problem/' },
      { title: 'Work through severity-based log routing', href: '/blog/severity-based-log-routing/' },
      { title: 'Get the OTTL quick reference', href: '/ottl-cheatsheet/' },
    ],
    curriculum: 'Continue with Collector modules covering OTTL, queues, WAL, authentication, TLS, connectors and scaling.',
  },
  {
    title: 'Design telemetry contracts and instrumentation',
    audience: 'For software engineers and teams standardizing instrumentation across services.',
    outcome: 'Use the Weaver guide to connect a versioned telemetry schema to generated code, then examine what preserving the OpenTelemetry data model means.',
    resources: [
      { title: 'Follow the Weaver getting-started guide', href: '/blog/weaver-from-zero-to-hero/' },
      { title: 'Understand OTLP versus OpenTelemetry-native support', href: '/blog/otlp-is-not-otel-native/' },
    ],
    curriculum: 'Continue with course modules on the data model, context propagation, API, SDK and manual instrumentation.',
  },
  {
    title: 'Learn from the wider OpenTelemetry community',
    audience: 'For engineers evaluating approaches and keeping their knowledge current.',
    outcome: 'Explore curated conference talks and the OTel Drops podcast, with technical articles available when you want a deeper explanation.',
    resources: [
      { title: 'Explore six KubeCon EU 2026 talks', href: '/blog/best-otel-talks-kubecon-eu-2026/' },
      { title: 'Explore three KubeCon India 2026 talks', href: '/blog/best-otel-talks-kubecon-india-2026/' },
      { title: 'Listen to OTel Drops', href: '/podcast/' },
    ],
    curriculum: 'Continue with modules on architecture, migration and observability culture to connect implementation details to team decisions.',
  },
];
---

<Layout title="Learn OpenTelemetry — Practical Learning Paths" description="Explore OpenTelemetry learning paths for instrumentation, Collector pipelines and telemetry contracts. Start with free guides, then compare structured courses.">
  <div class="container-custom py-16 max-w-5xl space-y-12">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Learn OpenTelemetry' }]} />
    <header class="max-w-3xl space-y-5">
      <h1 class="text-3xl md:text-5xl font-bold">Learn OpenTelemetry by solving real engineering problems</h1>
      <p class="text-xl text-white/80">Choose a starting point that matches your work. Our public guides explain concrete decisions and configurations; our courses organize the wider subject into a progressive curriculum.</p>
      <p class="text-white/70">Written and taught by <a class="text-telemetria-orange hover:underline" href="/instructors/juraci-paixao-krohling/">Juraci Paixão Kröhling</a>, OpenTelemetry maintainer and Telemetry Drops founder.</p>
    </header>
    {paths.map((path) => (
      <section class="rounded-xl border border-white/10 bg-white/5 p-6 md:p-8 space-y-4">
        <h2 class="text-2xl font-semibold">{path.title}</h2>
        <p class="text-telemetria-orange">{path.audience}</p>
        <p class="text-white/80">{path.outcome}</p>
        <ul class="space-y-3">
          {path.resources.map((resource) => <li><a class="text-telemetria-orange hover:underline" href={resource.href}>{resource.title}</a></li>)}
        </ul>
        <p class="text-white/70">{path.curriculum} <a class="text-telemetria-orange hover:underline" href="/products/">Compare the course curricula</a>.</p>
      </section>
    ))}
    <section class="space-y-5">
      <h2 class="text-2xl font-semibold">Choose the support you need</h2>
      <p class="text-white/80">OTel Track is self-paced. OTel Specialization is an eight-week cohort program with weekly mentoring and personalized project feedback; check the course pages for current enrollment, waitlist options and prices.</p>
      <div class="flex flex-wrap gap-6 text-telemetria-orange">
        <a class="hover:underline" href="/products/otel-track/">Explore self-paced training</a>
        <a class="hover:underline" href="/products/otel-specialization/">Explore mentored training</a>
        <a class="hover:underline" href="/contact/">Ask about training for your team</a>
      </div>
    </section>
    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Preparing for OTCA?</h2>
      <p class="text-white/80">Use our <a class="text-telemetria-orange hover:underline" href="/otca-practice-exam/">unofficial OTCA practice exam</a> to check your understanding. The interactive quiz requires JavaScript. Completing a Telemetry Drops course does not award CNCF's OTCA credential.</p>
    </section>
  </div>
</Layout>
